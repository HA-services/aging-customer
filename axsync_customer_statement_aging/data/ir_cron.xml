<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="axsync_statement_send_cron" model="ir.cron">
        <field name="name">AXSync: send scheduled customer statements</field>
        <field name="model_id" ref="model_axsync_statement_engine"/>
        <field name="state">code</field>
        <field name="code">model.cron_send_statements()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
